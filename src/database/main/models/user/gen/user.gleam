pub const session_key = "_auth_user_id"

pub const max_login_attempts = 5

pub const lockout_seconds = 60

pub fn authenticate(
  session session: Session,
  pool pool: db.DbPool,
  email email: String,
  password password: String,
) -> Result(User, auth.AuthError) {
