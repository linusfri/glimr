  let user_result = by_email(pool: pool, email: email)

  let verified = case user_result {
    Error(_) -> {
      hash.dummy_verify(password)
      False
    }
    Ok(user) -> hash.verify(password, user.password)
  }

  case verified, user_result {
    True, Ok(user) -> {
      auth.clear_throttle(session, session_key)
      auth.login(session, int.to_string(user.id), session_key)
      Ok(user)
    }
    _, _ -> {
      auth.record_failure(
        session,
        session_key,
        max_login_attempts,
        lockout_seconds,
      )
      Error(auth.InvalidCredentials)
    }
  }
}

